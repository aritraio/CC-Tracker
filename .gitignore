# ==============================================================================
# CC Track — Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging & distribution
*.egg-info/
.installed.cfg
*.egg
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/

# Python test, coverage & linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ------------------------------------------------------------------------------
# Next.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
.next/
out/
.vercel
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit real credentials)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Temporary Files, Scratch & Raw Statements
# ------------------------------------------------------------------------------
scratch/
tmp/
/temp/
*.log

# Sensitive PDF statements (protect test files with PII from accidental commits)
# Note: Sample fixtures in tests/fixtures/ with anonymized synthetic data are allowed
/uploads/
*.pdf
!apps/api/tests/fixtures/*.pdf
