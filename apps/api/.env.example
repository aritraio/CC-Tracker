# ==============================================================================
# CC Track API — Environment Configuration Template
# ==============================================================================

PROJECT_NAME="CC Track API"
VERSION="0.1.0"
ENVIRONMENT="development"

# CORS Configuration (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Optional AI / LLM Keys (Deterministic fallback operates with 100% functionality without keys)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""

# Optional Database / Supabase URL (Uses in-memory storage if omitted)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/cctrack"
# SUPABASE_URL=""
# SUPABASE_KEY=""
